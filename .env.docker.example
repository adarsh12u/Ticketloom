# =============================================================================
# Docker Compose full-stack env (NO real production secrets in git)
# cp .env.docker.example .env.docker
# docker compose --env-file .env.docker --profile full up -d --build
# =============================================================================

NODE_ENV=production

# Public URLs as seen by the browser / OAuth callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# REQUIRED — openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Docker service DNS (inside the compose network)
DATABASE_URL=postgresql://ticketloom:ticketloom@postgres:5432/ticketloom?schema=public
REDIS_URL=redis://redis:6379
OLLAMA_BASE_URL=http://ollama:11434

POSTGRES_USER=ticketloom
POSTGRES_PASSWORD=ticketloom
POSTGRES_DB=ticketloom

# Host tip: Docker Postgres is also published at 127.0.0.1:5433 for tooling.
# Homebrew Postgres on :5432 is a SEPARATE database — do not mix volumes.

RATE_LIMIT_FAIL_CLOSED=true
AUTH_REQUIRE_EMAIL_VERIFICATION=true

AI_PROVIDER=ollama
AI_ENABLED=true
AI_MODEL=llama3.2
AI_EMBEDDING_MODEL=nomic-embed-text

SOCKET_PORT=3001
# SOCKET_CORS_ORIGINS=http://localhost:3000

# Optional Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMTP required for real email delivery in production
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Ticketloom <noreply@example.com>"
# For first local Docker run without SMTP:
EMAIL_ALLOW_CONSOLE=true
