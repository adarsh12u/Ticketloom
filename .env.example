# =============================================================================
# Ticketloom environment template (safe to commit — NO real secrets)
# Copy to `.env` for local Homebrew Postgres development.
# For Docker full stack, prefer `.env.docker.example` → `.env.docker`.
# =============================================================================

# --- Application URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# --- Auth.js ---
# Generate: openssl rand -base64 48
AUTH_SECRET=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Local-friendly defaults (recommended for first run):
# AUTH_REQUIRE_EMAIL_VERIFICATION=false
# EMAIL_ALLOW_CONSOLE=true
# EMAIL_DEV_CONSOLE_FALLBACK=true

# --- Database (Homebrew / host Postgres — NOT the Docker volume) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ticketloom?schema=public

# Development seed only
SEED_USER_PASSWORD=

# --- Redis (npm run redis:up → localhost:6379) ---
# Never expose REDIS_URL to the browser.
REDIS_URL=redis://127.0.0.1:6379
# Production recommendation: RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_FAIL_CLOSED=false

# --- SMTP (required in production unless EMAIL_ALLOW_CONSOLE=true) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Ticketloom <noreply@example.com>"
# EMAIL_DEV_CONSOLE_FALLBACK=true
# EMAIL_ALLOW_CONSOLE=false
# EMAIL_REQUIRED=

# --- Socket.IO ---
SOCKET_PORT=3001
# Comma-separated allowlist; defaults to NEXT_PUBLIC_APP_URL / AUTH_URL
# SOCKET_CORS_ORIGINS=http://localhost:3000

# --- AI / RAG (Ollama) ---
AI_PROVIDER=ollama
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
AI_EMBEDDING_MODEL=nomic-embed-text
# AI_PROVIDER=mock
# SKIP_ENV_VALIDATION=true
